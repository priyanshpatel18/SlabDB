# Canonical origin for sitemap, Open Graph, and JSON-LD. Not a secret.
# NEXT_PUBLIC_SITE_URL=https://slab.priyanshpatel.com

# Privy. Use app/.env. Git ignores it. Do not use .env.local unless you want to.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_SIGNER_ID=

# Server only. Never prefix these with NEXT_PUBLIC_.
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_KEY=

# Irys payer for CLI push. JSON secret-key byte array.
# If unset, the server uses ANCHOR_WALLET or ~/.config/solana/id.json.
# IRYS_SECRET_KEY=[1,2,3]

# Do not put Helius API keys in this app. Base RPC is
# https://rpc.magicblock.app/devnet. Do not use https://devnet.magicblock.app/
# as validator RPC.
